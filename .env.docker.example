# Docker 环境变量参考
# 复制为 .env.docker 并填入实际值后再运行 docker compose up
# ⚠️ 此文件包含敏感信息，禁止提交到版本控制！

# ============================================================
# Spring AI DashScope（必填）
# ============================================================
SPRING_AI_DASHSCOPE_API_KEY=your_dashscope_api_key_here
SPRING_AI_DASHSCOPE_CHAT_OPTIONS_MODEL=qwen-plus

# ============================================================
# Steam API（按需填写）
# ============================================================
STEAM_API_KEY=your_steam_api_key_here
STEAM_PROXY_HOST=127.0.0.1
STEAM_PROXY_PORT=7890

# ============================================================
# Search API（按需填写）
# ============================================================
SEARCH_API_BASE_URL=https://www.searchapi.io/api/v1/search?engine=google
SEARCH_API_KEY=your_searchapi_key_here

# ============================================================
# 数据库（按需覆盖）
# ============================================================
# 默认: jdbc:h2:~/rikka_raymi_v2（容器内持久化在命名卷 raymi-db 中）
# 如需切换为内存模式: DATABASE_URL=jdbc:h2:mem:testdb
# 如需外部 MySQL/PostgreSQL: DATABASE_URL=jdbc:mysql://host:3306/raymi
DATABASE_URL=jdbc:h2:~/rikka_raymi_v2
DATABASE_USERNAME=root
DATABASE_PASSWORD=123456

# ============================================================
# 日志存储路径（可选）
# ============================================================
# 容器内默认 /app/logs，docker-compose 已通过命名卷挂载
# docker run 时可通过 -e LOG_PATH=/path/to/host/logs 改为绑挂路径
LOG_PATH=/app/logs

# ============================================================
# Spring Profile（一般不需要改）
# ============================================================
SPRING_PROFILES_ACTIVE=docker,dev,secret

# ============================================================
# JVM 内存（可选）
# ============================================================
JAVA_XMS=512m
JAVA_XMX=1024m
